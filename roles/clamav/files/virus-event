#!/bin/bash

ALERT="Signature detected by ClamAV: ${CLAM_VIRUSEVENT_VIRUSNAME} in \
${CLAM_VIRUSEVENT_FILENAME}"
PATH=/usr/bin

for uid in $(/usr/bin/ls -1 /run/user); do
	/usr/bin/sudo \
		--user "#${uid}" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
		PATH="${PATH}" \
		/usr/bin/notify-send \
		--icon dialog-warning \
		--urgency critical \
		"Virus found!" \
		"${ALERT}"
done
